# scratch
*.tmp
scratch/

# note: out/ is committed intentionally -- report bundles are deliverables,
# regenerable from scripts/ but kept so every reported figure has its CSV.
/out/presentation2_selftest/
.workers/
.claude/settings.local.json

# run-time leftovers under out/ (logs, matplotlib cache, quick pre-runs); the
# committed deliverables in each out/<run>/ are unaffected
/out/**/mplconfig/
/out/**/quick/
/out/**/*.log

# report staging (weekly report inputs copied from memory / ~/.claude)
/reports/

# FSIM Studio run cache (results keyed by fsim_core source hash)
.cache/
cards/studio/p2a-verify-*.yaml
cards/studio/probe-*.yaml

